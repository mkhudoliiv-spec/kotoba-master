{
  "kanji": {
    "国": {
      "meaning": "Країна",
      "exceptions": "У деяких сполуках こく озвончується в ごく: 中国 — ちゅうごく (Китай).",
      "add": [["中国", "ちゅうごく", "Китай", "On"]]
    },
    "本": {
      "meaning": "Книга; основа; справжній",
      "exceptions": "Як лічильний суфікс довгих предметів ほん змінюється: 一本 — いっぽん, 三本 — さんぼん, 六本 — ろっぽん. 日本 читається にほん або にっぽん.",
      "add": [["日本", "にほん", "Японія", "On"], ["本屋", "ほんや", "книгарня", "On"]]
    },
    "長": {
      "meaning": "Довгий; керівник",
      "exceptions": "On-yomi ちょう у сполуках часто означає «голова, керівник»: 社長, 校長, 部長."
    },
    "出": {
      "meaning": "Виходити; виймати",
      "exceptions": "Перед к/с/т/п しゅつ скорочується до しゅっ: 出席 — しゅっせき, 出発 — しゅっぱつ (відправлення).",
      "onYomi": ["しゅつ - shutsu"],
      "kunYomi": ["で(る) - de(ru)", "だ(す) - da(su)"]
    },
    "行": {
      "meaning": "Іти; здійснювати",
      "exceptions": "行く — неправильне дієслово: те-форма 行って — いって, минулий час 行った — いった. Читання ゆく — книжне.",
      "add": [["行く", "いく", "іти; їхати", "Kun"]],
      "onYomi": ["こう - kou", "ぎょう - gyou"],
      "kunYomi": ["い(く) - i(ku)", "ゆ(く) - yu(ku)", "おこな(う) - okona(u)"]
    },
    "見": {
      "meaning": "Бачити; дивитися",
      "exceptions": "見る — дієслово ru-групи: 見ます, 見て. Не плутайте 見る (дивитися) і 見える (бути видимим, виднітися)."
    },
    "後": {
      "meaning": "Після; позаду",
      "exceptions": "明後日 — あさって (післязавтра) — особливе читання всього слова. Часове «після» — 後で — あとで, просторове «позаду» — 後ろ — うしろ.",
      "onYomi": ["ご - go", "こう - kou"],
      "kunYomi": ["あと - ato", "うし(ろ) - ushi(ro)", "のち - nochi"]
    },
    "前": {
      "meaning": "Перед; раніше",
      "exceptions": "",
      "add": [["駅前", "えきまえ", "привокзальна площа; біля вокзалу", "Kun"]]
    },
    "間": {
      "meaning": "Проміжок; між",
      "exceptions": "Після числа: 一時間 — いちじかん (одна година), 一週間 — いっしゅうかん (один тиждень). Kun ま звучить у 間違える і 昼間, あいだ — окреме слово."
    },
    "東": {
      "meaning": "Схід",
      "exceptions": "",
      "add": [["東京", "とうきょう", "Токіо", "On"], ["東口", "ひがしぐち", "східний вихід", "Kun"]]
    },
    "今": {
      "meaning": "Тепер; зараз",
      "exceptions": "Особливі читання: 今日 — きょう, 今朝 — けさ, 今年 — ことし. А 今月 — こんげつ і 今週 — こんしゅう читаються регулярно через on-yomi こん."
    },
    "入": {
      "meaning": "Входити; вкладати",
      "exceptions": "入る читається はいる, але 入口 — いりぐち і 入れる — いれる беруть kun い. 入る — дієслово u-групи, хоч і закінчується на -іру: 入ります, 入って.",
      "onYomi": ["にゅう - nyuu"]
    },
    "高": {
      "meaning": "Високий; дорогий",
      "exceptions": "高い означає і «високий», і «дорогий»: この本は高いです — ця книжка дорога.",
      "add": [["高校", "こうこう", "старша школа", "On"]],
      "kunYomi": ["たか(い) - taka(i)", "たか - taka"]
    },
    "外": {
      "meaning": "Зовні; інший",
      "exceptions": "Як окреме слово 外 має два читання: そと — «надворі, зовні» та ほか — «інший, крім». ほか частіше пишуть хіраґаною.",
      "kunYomi": ["そと - soto", "ほか - hoka", "はず(す) - hazu(su)"]
    },
    "下": {
      "meaning": "Низ; під",
      "exceptions": "下手 — へた (невправний) — особливе читання, антонім до 上手 — じょうず. 下さい після те-форми зазвичай пишуть хіраґаною: 見てください.",
      "kunYomi": ["した - shita", "しも - shimo", "さ(げる) - sa(geru)", "くだ(さる) - kuda(saru)", "お(りる) - o(riru)"]
    },
    "来": {
      "meaning": "Приходити; наступний",
      "exceptions": "来る — неправильне дієслово, читання основи змінюється: 来ます — きます, 来ない — こない, 来て — きて.",
      "onYomi": ["らい - rai"],
      "kunYomi": ["く(る) - ku(ru)", "き(ます) - ki(masu)", "こ(ない) - ko(nai)"]
    },
    "気": {
      "meaning": "Дух; настрій; повітря",
      "exceptions": "Багато виразів із 気 — сталі звороти: 気をつける — きをつける (бути обережним), 気に入る — きにいる (подобатися).",
      "kunYomi": []
    },
    "話": {
      "meaning": "Розмова; розповідь",
      "exceptions": "Іменник 話 — はなし пишеться без окуріґани, дієслово — 話す — はなす."
    },
    "北": {
      "meaning": "Північ",
      "exceptions": "Перед к ほく скорочується: 北海道 — ほっかいどう.",
      "add": [["北海道", "ほっかいどう", "Хоккайдо", "On"], ["北口", "きたぐち", "північний вихід", "Kun"]]
    },
    "午": {
      "meaning": "Полудень",
      "exceptions": "",
      "add": [["正午", "しょうご", "полудень (12:00)", "On"]]
    },
    "書": {
      "meaning": "Писати",
      "exceptions": "У 葉書 — はがき (листівка) か озвончується в が."
    },
    "名": {
      "meaning": "Ім'я; відомий",
      "exceptions": "У 名前, 片仮名 і 平仮名 читання な — це kun. Назви абеток зазвичай пишуть каною: カタカナ, ひらがな."
    },
    "半": {
      "meaning": "Половина",
      "exceptions": "",
      "add": [["半年", "はんとし", "пів року", "On"]]
    },
    "西": {
      "meaning": "Захід",
      "exceptions": "",
      "add": [["西口", "にしぐち", "західний вихід", "Kun"]],
      "onYomi": ["せい - sei", "さい - sai"]
    },
    "電": {
      "meaning": "Електрика",
      "exceptions": ""
    },
    "校": {
      "meaning": "Школа",
      "exceptions": "У 学校 — がっこう がく скорочується до がっ.",
      "onYomi": ["こう - kou"]
    },
    "語": {
      "meaning": "Слово; мова",
      "exceptions": "Суфікс 語 утворює назви мов: 日本語 — にほんご, 英語 — えいご.",
      "add": [["日本語", "にほんご", "японська мова", "On"], ["単語", "たんご", "слово (лексична одиниця)", "On"]]
    },
    "聞": {
      "meaning": "Чути; питати",
      "exceptions": "聞く має два значення: «слухати» і «питати»: 先生に聞く — спитати вчителя."
    },
    "食": {
      "meaning": "Їсти; їжа",
      "exceptions": "",
      "onYomi": ["しょく - shoku"],
      "kunYomi": ["た(べる) - ta(beru)", "く(う) - ku(u)"]
    },
    "車": {
      "meaning": "Машина; колесо",
      "exceptions": ""
    },
    "何": {
      "meaning": "Що",
      "exceptions": "なに чи なん: перед т, д, н і лічильними суфіксами — なん (何ですか, 何時, 何人), в інших випадках — なに (何を食べますか).",
      "add": [["何", "なに", "що", "Kun"], ["何時", "なんじ", "котра година", "Kun"], ["何人", "なんにん", "скільки людей", "Kun"]]
    },
    "南": {
      "meaning": "Південь",
      "exceptions": "",
      "add": [["南口", "みなみぐち", "південний вихід", "Kun"], ["南米", "なんべい", "Південна Америка", "On"]],
      "onYomi": ["なん - nan"]
    },
    "毎": {
      "meaning": "Кожен",
      "exceptions": "毎月 і 毎年 мають по два читання: まいつき / まいげつ, まいとし / まいねん — обидва правильні.",
      "add": [["毎月", "まいつき", "щомісяця", "On"], ["毎年", "まいとし", "щороку", "On"]],
      "kunYomi": []
    },
    "白": {
      "meaning": "Білий",
      "exceptions": "У 面白い — おもしろい (цікавий) 白 читається kun しろ, хоча слово складається з двох канджі."
    },
    "天": {
      "meaning": "Небо",
      "exceptions": "",
      "add": [["天ぷら", "てんぷら", "темпура", "On"]],
      "kunYomi": ["あめ - ame", "あま - ama"]
    },
    "母": {
      "meaning": "Мати",
      "exceptions": "お母さん — おかあさん — особливе читання. Про власну матір кажуть 母 — はは, про чужу і при звертанні — お母さん.",
      "kunYomi": ["はは - haha"]
    },
    "右": {
      "meaning": "Право; правий",
      "exceptions": "",
      "add": [["右手", "みぎて", "права рука", "Kun"], ["左右", "さゆう", "ліворуч і праворуч", "On"]]
    },
    "読": {
      "meaning": "Читати",
      "exceptions": "読む — u-дієслово: 読みます, 読んで, 読んだ.",
      "add": [["読書", "どくしょ", "читання книжок", "On"], ["読み方", "よみかた", "спосіб читання (як читається)", "Kun"]]
    },
    "友": {
      "meaning": "Друг",
      "exceptions": "",
      "add": [["友人", "ゆうじん", "друг (офіційно)", "On"]]
    },
    "左": {
      "meaning": "Ліво; лівий",
      "exceptions": "",
      "add": [["左手", "ひだりて", "ліва рука", "Kun"], ["左右", "さゆう", "ліворуч і праворуч", "On"]],
      "onYomi": ["さ - sa"]
    }
  },

